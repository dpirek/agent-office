# Server
# Use 0.0.0.0 when workers connect from another machine or container.
HOST=127.0.0.1
PORT=8005

# Workspace managed by the office. Use an absolute path.
AI_HARNESS_WORKSPACE=/absolute/path/to/your/workspace

# Optional runtime data location for SQLite and generated state.
# AI_HARNESS_DATA_DIR=/absolute/path/to/agent-office/.workspace
# AI_HARNESS_SHARED_WORKSPACE=/absolute/path/to/shared-agent-deliveries

# Required shared credential for workers connecting to ws(s)://HOST:PORT/ws/workers.
# Use a long random value and provide it in the worker's register message.
AI_HARNESS_WORKER_TOKEN=replace-with-a-long-random-token

# Ask workers for progress after a task has run this long, then repeat at this interval.
# Minimum 10000 (10 seconds); default 300000 (5 minutes).
AI_HARNESS_TASK_PROGRESS_CHECK_INTERVAL_MS=300000

# Optional: force the dashboard to connect with ws:// even when loaded over HTTPS.
# Browsers normally block this as mixed content; use only in a trusted environment
# whose browser/webview explicitly permits insecure WebSockets.
# AI_HARNESS_ALLOW_INSECURE_WEBSOCKET=false

# Provider: openai, ollama, or custom
AI_PROVIDER=openai
AI_MODEL=gpt-5.1-codex
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=

# Provider-specific fallbacks. Uncomment the provider you use.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1-codex
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# CUSTOM_AI_MODEL=custom-model
# CUSTOM_AI_BASE_URL=http://127.0.0.1:8000/v1
# CUSTOM_AI_API_KEY=

# Internal tool permissions: true or false
AI_HARNESS_TOOL_MANAGE_OFFICE_TASKS=true
AI_HARNESS_TOOL_READ_OFFICE_MEMORY=true
AI_HARNESS_TOOL_LIST_FILES=true
AI_HARNESS_TOOL_READ_FILE=true
AI_HARNESS_TOOL_WRITE_FILE=true
AI_HARNESS_TOOL_SEARCH_FILES=true
AI_HARNESS_TOOL_CURL=true
AI_HARNESS_TOOL_RUN_COMMAND=true
AI_HARNESS_TOOL_CHROME_DEVTOOLS=true
AI_HARNESS_TOOL_DELEGATE_TO_SUB_AGENT=true

# Orchestration stages: true or false
AI_HARNESS_WORKFLOW_COMPOSER=true
AI_HARNESS_WORKFLOW_TOOLS=true
AI_HARNESS_WORKFLOW_MCP=true
AI_HARNESS_WORKFLOW_VALIDATION=true

# Optional comma-separated skill names or IDs already registered in Knowledge.
# AI_HARNESS_SKILLS=release-checks,documentation

# Optional MCP configuration. The path is resolved from the project directory.
# AI_HARNESS_MCP_CONFIG_PATH=.ai-harness/config.toml
# AI_HARNESS_MCP_SERVERS={"servers":[]}

# Optional system prompt overrides.
# AI_HARNESS_PROMPT_REFINEMENT=
# AI_HARNESS_AGENT_INSTRUCTIONS=
# AI_HARNESS_WORKSPACE_CONTEXT=
# AI_HARNESS_TOOL_CONTRACT=
# AI_HARNESS_VALIDATION_REMINDER=
